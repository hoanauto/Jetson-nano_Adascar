{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build RPLIDAR Project",
            "type": "shell",
            "command": "cd ${workspaceFolder} && mkdir -p build && cd build && cmake .. && make -j4",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "cd ${workspaceFolder} && rm -rf build",
            "group": "build"
        },
        {
            "label": "Run with sudo",
            "type": "shell",
            "command": "cd ${workspaceFolder}/build && sudo ./lidar_app",
            "group": "test",
            "dependsOn": "Build RPLIDAR Project"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}